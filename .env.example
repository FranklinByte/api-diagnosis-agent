# Copy to .env (git-ignored). Any OpenAI-compatible endpoint works.
# Without these three values the service still runs and returns the tool
# findings with a fixed explanation instead of a model-written one.
OPENAI_BASE_URL=https://your-provider.example/v1
OPENAI_MODEL=your-model
OPENAI_API_KEY=replace-me
# Seconds to wait for one model call.
OPENAI_TIMEOUT_SECONDS=60
# Upper bound on model calls per minute for the whole process.
API_DIAGNOSIS_LLM_CALLS_PER_MINUTE=30
