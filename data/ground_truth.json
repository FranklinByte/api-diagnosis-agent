    {"id": "auth-forbidden-001", "request": {"method": "POST", "path": "/weather/forecast", "headers": {"X-API-Version": "v2"}, "status_code": 403, "error_message": "scope denied", "body": {"city": "Toronto", "units": "imperial", "days": 2}}, "expected_status": "confirmed", "expected_category": "auth_error"},
