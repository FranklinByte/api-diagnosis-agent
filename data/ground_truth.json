    {"id": "version-v1-london-001", "request": {"method": "POST", "path": "/weather/forecast", "headers": {"X-API-Version": "v1"}, "body": {"city": "London", "units": "imperial", "days": 1}}, "expected_status": "confirmed", "expected_category": "version_incompatible"},
