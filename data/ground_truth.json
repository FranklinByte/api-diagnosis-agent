    {"id": "missing-units-001", "request": {"method": "POST", "path": "/weather/forecast", "headers": {"X-API-Version": "v2"}, "body": {"city": "Seoul", "days": 5}}, "expected_status": "confirmed", "expected_category": "missing_required_field"},
