{
  "schema_version": "v0-independent",
  "description": "Authored independent labeled observations for the Weather Mock API diagnosis benchmark. No repeat multiplier is used.",
  "label_contracts": {
    "no_fault": {"expected_primary_tool": "validate_openapi_contract", "evidence_source": "openapi", "needs_manual": false, "repair_principle": "No contract repair is required; optionally replay the allowlisted Mock request."},
    "missing_required_field": {"expected_primary_tool": "validate_openapi_contract", "evidence_source": "schema", "needs_manual": false, "repair_principle": "Add every required field identified by the JSON Pointer."},
    "field_type_error": {"expected_primary_tool": "validate_openapi_contract", "evidence_source": "schema", "needs_manual": false, "repair_principle": "Use the JSON type declared by OpenAPI."},
    "enum_invalid": {"expected_primary_tool": "validate_openapi_contract", "evidence_source": "schema", "needs_manual": false, "repair_principle": "Use one of the enum values declared by OpenAPI."},
    "unknown_field": {"expected_primary_tool": "validate_openapi_contract", "evidence_source": "schema", "needs_manual": false, "repair_principle": "Remove fields not declared by the request schema."},
    "method_error": {"expected_primary_tool": "validate_openapi_contract", "evidence_source": "openapi", "needs_manual": false, "repair_principle": "Use the method declared for the endpoint."},
    "path_error": {"expected_primary_tool": "validate_openapi_contract", "evidence_source": "openapi", "needs_manual": false, "repair_principle": "Use a path declared by the OpenAPI document."},
    "version_incompatible": {"expected_primary_tool": "check_api_version", "evidence_source": "changelog", "needs_manual": false, "repair_principle": "Migrate the request to the current documented version."},
    "unsupported": {"expected_primary_tool": "check_api_version", "evidence_source": "changelog", "needs_manual": true, "repair_principle": "Do not claim compatibility without matching changelog evidence."},
    "ambiguous": {"expected_primary_tool": "validate_openapi_contract", "evidence_source": "schema", "needs_manual": true, "repair_principle": "Correct every independent schema issue and validate again."},
    "auth_error": {"expected_primary_tool": "inspect_observed_response", "evidence_source": "observed_response", "needs_manual": true, "repair_principle": "Inspect credential presence, format, scope and environment without exposing the secret."},
    "content_type_error": {"expected_primary_tool": "inspect_observed_response", "evidence_source": "observed_response", "needs_manual": false, "repair_principle": "Send the media type declared by OpenAPI."},
    "rate_limited": {"expected_primary_tool": "inspect_observed_response", "evidence_source": "observed_response", "needs_manual": false, "repair_principle": "Respect Retry-After and use bounded retry/backoff."},
    "server_error": {"expected_primary_tool": "inspect_observed_response", "evidence_source": "observed_response", "needs_manual": true, "repair_principle": "Preserve trace evidence and escalate the upstream failure."},
    "timeout": {"expected_primary_tool": "inspect_observed_response", "evidence_source": "observed_response", "needs_manual": false, "repair_principle": "Apply an explicit timeout budget and bounded retry only when safe."},
    "response_schema_change": {"expected_primary_tool": "validate_openapi_contract", "evidence_source": "schema", "needs_manual": true, "repair_principle": "Compare the observed response with the current response schema and changelog."}
  },
  "cases": [
