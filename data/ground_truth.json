    {"id": "ambiguous-enum-unknown-001", "request": {"method": "POST", "path": "/weather/forecast", "headers": {"X-API-Version": "v2"}, "body": {"city": "Quito", "units": "kelvin", "days": 3, "extra": true}}, "expected_status": "ambiguous", "expected_category": "ambiguous"},
    {"id": "ambiguous-header-unknown-001", "request": {"method": "POST", "path": "/weather/forecast", "headers": {}, "body": {"city": "Manila", "units": "metric", "days": 3, "extra": "x"}}, "expected_status": "ambiguous", "expected_category": "ambiguous"},
