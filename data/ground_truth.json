    {"id": "valid-london-001", "request": {"method": "POST", "path": "/weather/forecast", "headers": {"X-API-Version": "v2"}, "body": {"city": "London", "units": "imperial", "days": 1}}, "expected_status": "confirmed", "expected_category": null},
